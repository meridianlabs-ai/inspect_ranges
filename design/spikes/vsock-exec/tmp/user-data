#cloud-config
hostname: agentvm
write_files:
  - path: /opt/vsockd.py
    permissions: "0755"
    encoding: b64
    content: 
  - path: /etc/systemd/system/vsockd.service
    content: |
      [Unit]
      Description=vsock exec daemon (spike)
      [Service]
      ExecStart=/usr/bin/python3 /opt/vsockd.py
      Restart=always
      [Install]
      WantedBy=multi-user.target
runcmd:
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, vsockd.service]
